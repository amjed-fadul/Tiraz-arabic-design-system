{
  "name": "tiraz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src scripts tests/tooling tests/browser/consumer.mjs index.html vite.config.ts *.json README.md docs/implementation-plan.md",
    "format:check": "prettier --check src scripts tests/tooling tests/browser/consumer.mjs index.html vite.config.ts *.json README.md docs/implementation-plan.md",
    "knowledge:build": "node scripts/knowledge.mjs",
    "knowledge:check": "node scripts/knowledge.mjs --check",
    "registry:build": "node scripts/registry.mjs",
    "registry:check": "node scripts/registry.mjs --check",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "test:consumer": "node tests/browser/consumer.mjs",
    "verify": "npm run knowledge:check && npm run registry:check && npm run test:tooling && npm test && npm run lint && npm run build && npm run format:check"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-direction": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.2.0",
    "@radix-ui/react-switch": "^1.4.0",
    "@radix-ui/react-tabs": "^1.2.0",
    "@radix-ui/react-toast": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "description": "Arabic-first, source-owned design system and interactive component workbench",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  }
}
