{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/landing.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/library/:path*",
      "destination": "/workbench.html"
    },
    {
      "source": "/start/:path*",
      "destination": "/workbench.html"
    },
    {
      "source": "/docs/:path*",
      "destination": "/workbench.html"
    },
    {
      "source": "/illustrations/:path*",
      "destination": "/workbench.html"
    },
    {
      "source": "/examples/:path*",
      "destination": "/workbench.html"
    }
  ]
}
