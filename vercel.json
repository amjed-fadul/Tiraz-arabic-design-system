{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/library/:path*",
      "destination": "/workbench.html"
    },
    {
      "source": "/start/:path*",
      "destination": "/workbench.html"
    },
    {
      "source": "/docs/:path*",
      "destination": "/workbench.html"
    },
    {
      "source": "/illustrations/:path*",
      "destination": "/workbench.html"
    },
    {
      "source": "/examples/:path*",
      "destination": "/workbench.html"
    }
  ]
}
