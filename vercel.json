{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/", "destination": "/landing.html" },
    { "source": "/library/:path*", "destination": "/index.html" },
    { "source": "/start/:path*", "destination": "/index.html" },
    { "source": "/docs/:path*", "destination": "/index.html" },
    { "source": "/illustrations/:path*", "destination": "/index.html" },
    { "source": "/examples/:path*", "destination": "/index.html" }
  ]
}
