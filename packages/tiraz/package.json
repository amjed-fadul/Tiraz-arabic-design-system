{
  "name": "@amjedfadul/tiraz",
  "version": "0.1.3-preview.4",
  "description": "Arabic-first React components, editable source, and AI-ready guidance",
  "license": "MIT",
  "type": "module",
  "homepage": "https://tiraz.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amjed-fadul/Tiraz-arabic-design-system.git",
    "directory": "packages/tiraz"
  },
  "bugs": "https://github.com/amjed-fadul/Tiraz-arabic-design-system/issues",
  "keywords": [
    "react",
    "arabic",
    "rtl",
    "design-system",
    "ui",
    "ai"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/system/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/system/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mascot": {
      "types": "./dist/types/mascot/Khayt.d.ts",
      "import": "./dist/mascot.js",
      "default": "./dist/mascot.js"
    },
    "./styles.css": "./styles.css",
    "./fonts.css": "./fonts.css",
    "./tokens.css": "./source/system/tokens.css",
    "./components.css": "./source/system/components.css",
    "./mascot.css": "./dist/mascot.css",
    "./ai/*": "./source/system/ai/*",
    "./source/*": "./source/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "tiraz": "./bin/tiraz.mjs"
  },
  "files": [
    "bin",
    "dist",
    "source",
    "styles.css",
    "fonts.css",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-direction": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.2.0",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-popper": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.0",
    "@radix-ui/react-tabs": "^1.2.0",
    "@radix-ui/react-toast": "^1.3.0",
    "lucide-react": "^1.55.0",
    "@daypicker/react": "10.0.2",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "semver": "7.8.5"
  }
}
